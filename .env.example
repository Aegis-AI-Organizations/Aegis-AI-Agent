# Aegis AI Agent Configuration Template

# Mandatory for loading this file (Internal logic)
LOAD_DOTENV=1

# Gateway Connection
GATEWAY_URL=http://localhost:8080
# The deployment token provided by the organization for initial registration
DEPLOYMENT_TOKEN=ag_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Agent Identity (Optional)
AGENT_NAME=rust-agent-01

# Health Server (Local Axum server)
# Default to loopback-only to avoid exposing the health endpoint publicly.
# Override to 0.0.0.0 for container/orchestrator deployments that require external probes.
HEALTH_BIND_ADDR=127.0.0.1
HEALTH_PORT=8081

# Dependencies Health Check (Optional)
INGEST_HOST=localhost
INGEST_PORT=7233
# Alternatively specify full URL:
# INGEST_HEALTH_URL=http://localhost:7233/healthz

# Development Flags
# SKIP_AGENT_INIT=1
